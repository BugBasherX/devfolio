# ==============================================================================
# Yuvraj Kurmi Portfolio — Environment Configuration
# ==============================================================================

# Port to listen on (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# To connect to Neon Serverless Postgres in cloud / production, uncomment
# and paste your Neon connection string below:
#
# DATABASE_URL=postgresql://<user>:<password>@<ep-proj-name>.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# If DATABASE_URL is left empty or not set, the backend automatically uses
# native local SQLite (data/portfolio.db in WAL mode) with zero network latency.

# ------------------------------------------------------------------------------
# SECURITY CONFIGURATION (Optional overrides)
# ------------------------------------------------------------------------------
# ADMIN_KEY=yk_sec_your_secret_key_here
# HMAC_SECRET=your_hmac_secret_for_ip_hashing_here
